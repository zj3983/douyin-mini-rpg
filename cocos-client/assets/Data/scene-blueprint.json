      ],
      "children": [
        "WorldStageHeader",
        "WorldStageScrollView",
        "WorldStageStatusLabel"
      ],
      "active": false,
      "runtimeGenerated": true,
      "bindings": {
        "stages": "resources/Data/cultivation-design.json#worldStages",
        "progress": "Canvas/DualModeGameController.getHighestClearedWorldStage",
        "selected": "Canvas/SharedCombatRoot/Runtime.advanceToStage"
      },
      "size": "full physical viewport mapped into Canvas design coordinates",
      "layout": "WorldStageSelectLayout safe-area page; opening hides BattleRoot and successful runtime selection restores it."
    },
