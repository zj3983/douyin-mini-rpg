{
  "scene": {
    "name": "MainBattle",
    "orientation": "portrait",
    "target": "douyin-mini-game",
    "designResolution": { "width": 750, "height": 1334 },
    "resolutionPolicy": "FIXED_WIDTH",
    "runtimeHeight": "computeBattleLayout(...).visibleHeight",
    "layout": {
      "authority": "BattleLayout.computeBattleLayout",
      "horizontalMovement": "movement.minX <= -300 and movement.maxX >= 300 at 390x844",
      "safeInsets": "CSS pixels converted by designWidth / cssWidth",
      "navigation": "navigationTop < movement.minY",
      "resize": "Recompute from browser/Cocos CSS size and visualViewport insets on every canvas-resize"
    },
    "notes": "Scene/BattleRoot is the serialized bootstrap host. PortraitBattleBootstrap is runtime authority for the Canvas dual-mode tree; serialized marker nodes document stable editor contracts only. WorldStageSelectRoot and its stable children are runtime-generated by PortraitBattleBootstrap and are intentionally absent from MainBattle.scene."
  },
  "nodes": [
    { "path": "Scene/BattleRoot", "components": ["PortraitBattleBootstrap"], "purpose": "Serialized bootstrap host." },
    { "path": "Canvas", "components": ["UITransform", "Canvas"], "children": ["UICamera", "WorldRoot", "DungeonRoot", "DualModeGameController"], "size": { "width": 750, "height": "visibleHeight" } },
    { "path": "Canvas/UICamera", "components": ["UITransform", "Camera"], "visibility": "UI_2D" },
    { "path": "Canvas/WorldRoot", "components": ["UITransform"], "children": ["BattleRoot", "WorldStageSelectRoot"], "active": true, "bindings": { "dualModeController": "Canvas/DualModeGameController" }, "size": { "width": 750, "height": "visibleHeight" } },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot", "components": ["UITransform", "Graphics", "WorldStageSelectController"], "children": ["WorldStageHeader", "WorldStageScrollView", "WorldStageStatusLabel"], "active": false, "runtimeGenerated": true, "bindings": { "stages": "resources/Data/cultivation-design.json#worldStages", "progress": "Canvas/DualModeGameController.getHighestClearedWorldStage", "selected": "Canvas/WorldRoot/BattleRoot/Runtime.advanceToStage" }, "size": "full physical viewport mapped into Canvas design coordinates", "layout": "WorldStageSelectLayout safe-area page; opening hides BattleRoot and successful runtime selection restores it." },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageHeader", "components": ["UITransform", "Graphics"], "children": ["WorldStageTitle", "WorldStageSubtitle", "WorldStageCloseButton"], "size": "computed from physical viewport scale and safe-area insets" },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageHeader/WorldStageCloseButton", "components": ["UITransform", "Graphics", "Button"], "children": ["WorldStageCloseIcon"], "bindings": { "click": "WorldStageSelectPage.close" }, "size": "48x48 physical pixels mapped into Canvas design coordinates", "minimumPhysicalTouchSize": 44, "cornerRadius": 6 },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView", "components": ["UITransform", "ScrollView"], "children": ["WorldStageViewport"], "layout": "Vertical scrolling; horizontal disabled; viewport avoids all safe-area edges." },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport", "components": ["UITransform", "Mask"], "children": ["WorldStageContent"] },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent", "components": ["UITransform"], "children": ["WorldStageGrid"], "bindings": { "ScrollView.content": "self" }, "height": "max(item rows, viewport height)" },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent/WorldStageGrid", "components": ["UITransform"], "children": ["WorldStageItem1", "WorldStageItem2", "WorldStageItem3", "WorldStageItem4", "WorldStageItem5", "WorldStageItem6", "WorldStageItem7", "WorldStageItem8", "WorldStageItem9", "WorldStageItem10"], "layout": "Two portrait columns or three landscape columns; fixed 68px physical item height." },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent/WorldStageGrid/WorldStageItem1", "components": ["UITransform", "Graphics", "Button"], "children": ["WorldStageItem1Label", "WorldStageItem1Badge", "WorldStageItem1Lock"], "size": "computed from physical viewport scale", "cornerRadius": 6 },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent/WorldStageGrid/WorldStageItem2", "components": ["UITransform", "Graphics", "Button"], "children": ["WorldStageItem2Label", "WorldStageItem2Badge", "WorldStageItem2Lock"], "size": "computed from physical viewport scale", "cornerRadius": 6 },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent/WorldStageGrid/WorldStageItem3", "components": ["UITransform", "Graphics", "Button"], "children": ["WorldStageItem3Label", "WorldStageItem3Badge", "WorldStageItem3Lock"], "size": "computed from physical viewport scale", "cornerRadius": 6 },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent/WorldStageGrid/WorldStageItem4", "components": ["UITransform", "Graphics", "Button"], "children": ["WorldStageItem4Label", "WorldStageItem4Badge", "WorldStageItem4Lock"], "size": "computed from physical viewport scale", "cornerRadius": 6, "badge": "精英" },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent/WorldStageGrid/WorldStageItem5", "components": ["UITransform", "Graphics", "Button"], "children": ["WorldStageItem5Label", "WorldStageItem5Badge", "WorldStageItem5Lock"], "size": "computed from physical viewport scale", "cornerRadius": 6 },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent/WorldStageGrid/WorldStageItem6", "components": ["UITransform", "Graphics", "Button"], "children": ["WorldStageItem6Label", "WorldStageItem6Badge", "WorldStageItem6Lock"], "size": "computed from physical viewport scale", "cornerRadius": 6 },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent/WorldStageGrid/WorldStageItem7", "components": ["UITransform", "Graphics", "Button"], "children": ["WorldStageItem7Label", "WorldStageItem7Badge", "WorldStageItem7Lock"], "size": "computed from physical viewport scale", "cornerRadius": 6, "badge": "精英" },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent/WorldStageGrid/WorldStageItem8", "components": ["UITransform", "Graphics", "Button"], "children": ["WorldStageItem8Label", "WorldStageItem8Badge", "WorldStageItem8Lock"], "size": "computed from physical viewport scale", "cornerRadius": 6 },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent/WorldStageGrid/WorldStageItem9", "components": ["UITransform", "Graphics", "Button"], "children": ["WorldStageItem9Label", "WorldStageItem9Badge", "WorldStageItem9Lock"], "size": "computed from physical viewport scale", "cornerRadius": 6 },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageScrollView/WorldStageViewport/WorldStageContent/WorldStageGrid/WorldStageItem10", "components": ["UITransform", "Graphics", "Button"], "children": ["WorldStageItem10Label", "WorldStageItem10Badge", "WorldStageItem10Lock"], "size": "computed from physical viewport scale", "cornerRadius": 6, "badge": "区域Boss" },
    { "path": "Canvas/WorldRoot/WorldStageSelectRoot/WorldStageStatusLabel", "components": ["UITransform", "Label"], "bindings": { "rejected": "world-stage-selection-rejected", "runtimeFailure": "BattleRuntimeController.advanceToStage result.ok false" }, "size": "computed above bottom safe-area inset" },
    { "path": "Canvas/DungeonRoot", "components": ["UITransform"], "children": ["DungeonFloor1", "DungeonFloor2", "DungeonFloor3", "DungeonRoomLabel", "DungeonStatusLabel", "DungeonInteractButton", "DungeonRunController"], "active": false, "size": { "width": 750, "height": "visibleHeight" }, "layout": "Controls use layout.navigationTop; floor bands resize to visibleHeight without scaling actors." },
    { "path": "Canvas/DungeonRoot/DungeonFloor1", "components": ["UITransform", "Graphics"], "children": ["DungeonFloor1Label", "DungeonFloor1RoomAnchor1", "DungeonFloor1RoomAnchor2", "DungeonFloor1DoorAnchor"], "size": { "width": 750, "height": "visibleHeight" } },
    { "path": "Canvas/DungeonRoot/DungeonFloor2", "components": ["UITransform", "Graphics"], "children": ["DungeonFloor2Label", "DungeonFloor2RoomAnchor1", "DungeonFloor2RoomAnchor2", "DungeonFloor2DoorAnchor"], "size": { "width": 750, "height": "visibleHeight" } },
    { "path": "Canvas/DungeonRoot/DungeonFloor3", "components": ["UITransform", "Graphics"], "children": ["DungeonFloor3Label", "DungeonFloor3RoomAnchor1", "DungeonFloor3RoomAnchor2", "DungeonFloor3DoorAnchor"], "size": { "width": 750, "height": "visibleHeight" } },
    { "path": "Canvas/DungeonRoot/DungeonRoomLabel", "components": ["UITransform", "Label"], "bindings": { "snapshot": "Canvas/DungeonRoot/DungeonRunController.getRunSnapshot" } },
    { "path": "Canvas/DungeonRoot/DungeonStatusLabel", "components": ["UITransform", "Label"], "bindings": { "presentation": "Canvas/DungeonRoot/DungeonRunController.onRunChanged" } },
    { "path": "Canvas/DungeonRoot/DungeonInteractButton", "components": ["UITransform", "Graphics", "Button"], "children": ["DungeonInteractLabel"], "bindings": { "click": "PortraitBattleBootstrap.interactWithDungeon" }, "size": { "width": 360, "height": 68 } },
    { "path": "Canvas/DungeonRoot/DungeonRunController", "components": ["UITransform", "DungeonRunController"], "bindings": { "profileData": "resources/Data/dual-mode-slice.json", "roomLabel": "Canvas/DungeonRoot/DungeonRoomLabel" } },
    { "path": "Canvas/DualModeGameController", "components": ["UITransform", "DualModeGameController"], "bindings": { "worldRoot": "Canvas/WorldRoot", "dungeonRoot": "Canvas/DungeonRoot", "dungeonRun": "Canvas/DungeonRoot/DungeonRunController" } },
    { "path": "Canvas/WorldRoot/BattleRoot", "components": ["UITransform"], "children": ["WorldLayer", "ActorLayer", "EffectLayer", "DropLayer", "InputLayer", "HudLayer", "Runtime"], "size": { "width": 750, "height": "visibleHeight" } },
    { "path": "Canvas/WorldRoot/BattleRoot/WorldLayer", "components": ["UITransform"], "children": ["FarBackground", "MidBackground"] },
    { "path": "Canvas/WorldRoot/BattleRoot/WorldLayer/FarBackground", "components": ["UITransform", "Sprite"], "resource": "Assets/World/MistBamboo/far/spriteFrame", "size": "cover visibleHeight while preserving 750x1334 aspect", "alpha": 255 },
    { "path": "Canvas/WorldRoot/BattleRoot/WorldLayer/MidBackground", "components": ["UITransform", "Sprite"], "resource": "Assets/World/MistBamboo/mid/spriteFrame", "size": "cover visibleHeight while preserving 750x1334 aspect", "alpha": 168 },
    { "path": "Canvas/WorldRoot/BattleRoot/ActorLayer", "components": ["UITransform"], "children": ["Player", "EnemyPool", "EnemySpawner"] },
    { "path": "Canvas/WorldRoot/BattleRoot/ActorLayer/Player", "components": ["UITransform", "Sprite", "AtlasAnimator", "PlayerController"], "bindings": { "animationManifest": "resources/Data/animation-atlas.json", "actorId": "qinglan-sword-cultivator", "movementBounds": "layout.movement" }, "position": { "x": -210, "y": -80 }, "scale": 0.45 },
    { "path": "Canvas/WorldRoot/BattleRoot/ActorLayer/EnemyPool", "components": ["UITransform", "NodePoolController"], "capacity": 18 },
    { "path": "Canvas/WorldRoot/BattleRoot/ActorLayer/EnemySpawner", "components": ["UITransform", "EnemySpawner"], "bindings": { "enemyPool": "Canvas/WorldRoot/BattleRoot/ActorLayer/EnemyPool" }, "futureBossLayout": { "spawn": "layout.bossSpawn", "maxVisualBounds": "layout.bossMaxVisualBounds" } },
    { "path": "Canvas/WorldRoot/BattleRoot/EffectLayer", "components": ["UITransform"], "children": ["FlyingSwordSkill", "DamageNumberPool", "BossEffectPool"] },
    { "path": "Canvas/WorldRoot/BattleRoot/EffectLayer/FlyingSwordSkill", "components": ["UITransform", "FlyingSwordSkill"], "children": ["Sword"], "bindings": { "battleRuntime": "Canvas/WorldRoot/BattleRoot/Runtime", "sword": "Canvas/WorldRoot/BattleRoot/EffectLayer/FlyingSwordSkill/Sword", "playerActions": "Canvas/WorldRoot/BattleRoot/ActorLayer/Player/AtlasAnimator" } },
    { "path": "Canvas/WorldRoot/BattleRoot/EffectLayer/FlyingSwordSkill/Sword", "components": ["UITransform", "Sprite"], "resource": "Assets/Skills/FlyingSword/sword-projectile-v2/spriteFrame", "size": { "width": 176, "height": 44 } },
    { "path": "Canvas/WorldRoot/BattleRoot/DropLayer", "components": ["UITransform"], "children": ["SoulOrbPool"] },
    { "path": "Canvas/WorldRoot/BattleRoot/DropLayer/SoulOrbPool", "components": ["UITransform", "NodePoolController"], "capacity": 24 },
    { "path": "Canvas/WorldRoot/BattleRoot/InputLayer", "components": ["UITransform", "BattleInputController"], "bindings": { "player": "Canvas/WorldRoot/BattleRoot/ActorLayer/Player", "inputArea": "Canvas/WorldRoot/BattleRoot/InputLayer" }, "bounds": "layout.movement", "size": { "width": 750, "height": "visibleHeight / 2 - layout.navigationTop" }, "positionY": 0, "anchorY": "-layout.navigationTop / height", "excludes": "BottomNavigation and bottom safe inset" },
    { "path": "Canvas/WorldRoot/BattleRoot/HudLayer", "components": ["UITransform", "BattleHudController"], "children": ["TopHud", "BossHud", "BottomNavigation", "StageClearPanel"] },
    { "path": "Canvas/WorldRoot/BattleRoot/HudLayer/TopHud", "components": ["UITransform", "Graphics"], "positionY": "layout-safe top HUD position" },
    { "path": "Canvas/WorldRoot/BattleRoot/HudLayer/BossHud", "components": ["UITransform", "Graphics"], "active": false, "positionY": "layout-safe boss HUD position" },
    { "path": "Canvas/WorldRoot/BattleRoot/HudLayer/BottomNavigation", "components": ["UITransform", "Graphics"], "children": ["WorldStageEntryButton", "DungeonEntryButton", "Nav3", "Nav4", "Nav5", "Nav6"], "height": 104, "positionY": "layout.navigationTop - 52" },
    { "path": "Canvas/WorldRoot/BattleRoot/HudLayer/BottomNavigation/WorldStageEntryButton", "components": ["UITransform", "Button"], "children": ["Nav1"], "bindings": { "click": "PortraitBattleBootstrap.openWorldStageSelect" }, "size": { "width": 125, "height": 104 } },
    { "path": "Canvas/WorldRoot/BattleRoot/HudLayer/BottomNavigation/DungeonEntryButton", "components": ["UITransform", "Button"], "children": ["Nav2", "DungeonEntryStatusLabel"], "bindings": { "click": "Canvas/DualModeGameController.enterDungeon" }, "size": { "width": 125, "height": 104 } },
    { "path": "Canvas/WorldRoot/BattleRoot/HudLayer/StageClearPanel", "components": ["UITransform", "Graphics", "StageClearPanelController"], "active": false, "size": { "width": 472, "height": 214 }, "children": ["ClearTitle", "RewardLabel", "ContinueButton"] },
    { "path": "Canvas/WorldRoot/BattleRoot/Runtime", "components": ["UITransform", "BattleRuntimeController"], "bindings": { "designData": "resources/Data/cultivation-design.json", "enemySpawner": "Canvas/WorldRoot/BattleRoot/ActorLayer/EnemySpawner", "soulOrbPool": "Canvas/WorldRoot/BattleRoot/DropLayer/SoulOrbPool", "damageNumberPool": "Canvas/WorldRoot/BattleRoot/EffectLayer/DamageNumberPool", "bossSkillEffectPool": "Canvas/WorldRoot/BattleRoot/EffectLayer/BossEffectPool", "playerNode": "Canvas/WorldRoot/BattleRoot/ActorLayer/Player", "hud": "Canvas/WorldRoot/BattleRoot/HudLayer", "stageClearPanel": "Canvas/WorldRoot/BattleRoot/HudLayer/StageClearPanel", "dualMode": "Canvas/DualModeGameController" } }
  ]
}
