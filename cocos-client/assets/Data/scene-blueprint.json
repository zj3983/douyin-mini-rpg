{
  "scene": {
    "name": "MainBattle",
    "orientation": "portrait",
    "target": "douyin-mini-game",
    "designResolution": {
      "width": 750,
      "height": 1334
    },
    "resolutionPolicy": "FIXED_WIDTH",
    "runtimeHeight": "view.getVisibleSize().height",
    "notes": "Scene/BattleRoot is the serialized bootstrap host. It creates the runtime Canvas and its own Canvas/BattleRoot tree."
  },
  "nodes": [
    {
      "path": "Scene/BattleRoot",
      "components": ["PortraitBattleBootstrap"],
      "purpose": "Existing serialized scene node that hosts the bootstrap component."
    },
    {
      "path": "Canvas",
      "components": ["UITransform", "Canvas"],
      "children": ["UICamera", "BattleRoot"],
      "size": { "width": 750, "height": "visibleHeight" }
    },
    {
      "path": "Canvas/UICamera",
      "components": ["UITransform", "Camera"],
      "visibility": "UI_2D"
    },
    {
      "path": "Canvas/BattleRoot",
      "components": ["UITransform"],
      "children": ["WorldLayer", "ActorLayer", "EffectLayer", "DropLayer", "InputLayer", "HudLayer", "Runtime"],
      "size": { "width": 750, "height": "visibleHeight" }
    },
    {
      "path": "Canvas/BattleRoot/WorldLayer",
      "components": ["UITransform"],
      "children": ["FarBackground", "MidBackground"]
    },
    {
      "path": "Canvas/BattleRoot/WorldLayer/FarBackground",
      "components": ["UITransform", "Sprite"],
      "resource": "Assets/World/MistBamboo/far/spriteFrame",
      "size": "cover visibleHeight while preserving 750x1334 aspect",
      "alpha": 255
    },
    {
      "path": "Canvas/BattleRoot/WorldLayer/MidBackground",
      "components": ["UITransform", "Sprite"],
      "resource": "Assets/World/MistBamboo/mid/spriteFrame",
      "size": "cover visibleHeight while preserving 750x1334 aspect",
      "alpha": 168,
      "parallax": "bounded horizontal drift"
    },
    {
      "path": "Canvas/BattleRoot/ActorLayer",
      "components": ["UITransform"],
      "children": ["Player", "EnemyPool", "EnemySpawner"]
    },
    {
      "path": "Canvas/BattleRoot/ActorLayer/Player",
      "components": ["UITransform", "Sprite", "AtlasAnimator", "PlayerController"],
      "bindings": {
        "animationManifest": "resources/Data/animation-atlas.json",
        "actorId": "qinglan-sword-cultivator"
      },
      "position": { "x": -210, "y": -80 },
      "scale": 0.8,
      "initialAction": "sword_ride"
    },
    {
      "path": "Canvas/BattleRoot/ActorLayer/EnemyPool",
      "components": ["UITransform", "NodePoolController"],
      "capacity": 18,
      "factoryComponents": ["UITransform", "Sprite", "AtlasAnimator", "EnemyController", "EnemyVisualController", "PoolableActor"],
      "profiles": ["moss-wolf", "green-wing-moth", "bamboo-warden"]
    },
    {
      "path": "Canvas/BattleRoot/ActorLayer/EnemySpawner",
      "components": ["UITransform", "EnemySpawner"],
      "bindings": { "enemyPool": "Canvas/BattleRoot/ActorLayer/EnemyPool" }
    },
    {
      "path": "Canvas/BattleRoot/EffectLayer",
      "components": ["UITransform"],
      "children": ["FlyingSwordSkill", "DamageNumberPool", "BossEffectPool"]
    },
    {
      "path": "Canvas/BattleRoot/EffectLayer/FlyingSwordSkill",
      "components": ["UITransform", "FlyingSwordSkill"],
      "bindings": {
        "battleRuntime": "Canvas/BattleRoot/Runtime",
        "sword": "Canvas/BattleRoot/EffectLayer/FlyingSwordSkill/Sword",
        "playerActions": "Canvas/BattleRoot/ActorLayer/Player/AtlasAnimator"
      },
      "children": ["Sword"]
    },
    {
      "path": "Canvas/BattleRoot/EffectLayer/FlyingSwordSkill/Sword",
      "components": ["UITransform", "Sprite"],
      "resource": "Assets/Skills/FlyingSword/sword-projectile-v2/spriteFrame",
      "size": { "width": 176, "height": 44 }
    },
    {
      "path": "Canvas/BattleRoot/DropLayer",
      "components": ["UITransform"],
      "children": ["SoulOrbPool"]
    },
    {
      "path": "Canvas/BattleRoot/DropLayer/SoulOrbPool",
      "components": ["UITransform", "NodePoolController"],
      "capacity": 24,
      "factoryComponents": ["UITransform", "Graphics", "PoolableActor", "SoulOrbController"]
    },
    {
      "path": "Canvas/BattleRoot/InputLayer",
      "components": ["UITransform", "BattleInputController"],
      "bindings": {
        "player": "Canvas/BattleRoot/ActorLayer/Player",
        "inputArea": "Canvas/BattleRoot/InputLayer"
      },
      "size": { "width": 750, "height": "visibleHeight - 104" },
      "positionY": 52
    },
    {
      "path": "Canvas/BattleRoot/HudLayer",
      "components": ["UITransform", "BattleHudController"],
      "children": ["TopHud", "BossHud", "BottomNavigation", "StageClearPanel"]
    },
    {
      "path": "Canvas/BattleRoot/HudLayer/TopHud",
      "components": ["UITransform", "Graphics"],
      "children": ["RealmLabel", "StageLabel", "HealthBar", "ManaBar", "SoulBar"],
      "positionY": "visibleHeight / 2 - 83"
    },
    {
      "path": "Canvas/BattleRoot/HudLayer/BossHud",
      "components": ["UITransform", "Graphics"],
      "children": ["BossNameLabel", "BossHealthBar"],
      "active": false,
      "positionY": "visibleHeight / 2 - 179"
    },
    {
      "path": "Canvas/BattleRoot/HudLayer/BottomNavigation",
      "components": ["UITransform", "Graphics"],
      "height": 104,
      "positionY": "-visibleHeight / 2 + 52",
      "labels": ["战斗", "副本", "抽卡", "装备", "背包", "法宝"]
    },
    {
      "path": "Canvas/BattleRoot/HudLayer/StageClearPanel",
      "components": ["UITransform", "Graphics", "StageClearPanelController"],
      "active": false,
      "size": { "width": 520, "height": 258 },
      "children": ["ClearTitle", "RewardLabel", "ContinueButton"],
      "purpose": "Compact click-driven clear panel; rewards remain on one row."
    },
    {
      "path": "Canvas/BattleRoot/Runtime",
      "components": ["UITransform", "BattleRuntimeController"],
      "bindings": {
        "designData": "resources/Data/cultivation-design.json",
        "enemySpawner": "Canvas/BattleRoot/ActorLayer/EnemySpawner",
        "soulOrbPool": "Canvas/BattleRoot/DropLayer/SoulOrbPool",
        "damageNumberPool": "Canvas/BattleRoot/EffectLayer/DamageNumberPool",
        "bossSkillEffectPool": "Canvas/BattleRoot/EffectLayer/BossEffectPool",
        "playerNode": "Canvas/BattleRoot/ActorLayer/Player",
        "hud": "Canvas/BattleRoot/HudLayer",
        "stageClearPanel": "Canvas/BattleRoot/HudLayer/StageClearPanel"
      }
    }
  ]
}
