{
  "scene": {
    "name": "MainBattle",
    "orientation": "portrait",
    "target": "douyin-mini-game",
    "designResolution": {
      "width": 750,
      "height": 1334
    },
    "resolutionPolicy": "FIXED_WIDTH",
    "notes": "PortraitBattleBootstrap assembles the visible runtime hierarchy after the serialized scene loads."
  },
  "nodes": [
    {
      "path": "Scene/BattleRoot",
      "components": ["PortraitBattleBootstrap"],
      "purpose": "Serialized bootstrap host in MainBattle.scene."
    },
    {
      "path": "Canvas",
      "components": ["Canvas"],
      "children": ["BattleRoot", "Pools"]
    },
    {
      "path": "Canvas/BattleRoot",
      "components": [],
      "children": ["WorldLayer", "ActorLayer", "EffectLayer", "DropLayer", "InputLayer", "HudLayer", "Runtime"]
    },
    {
      "path": "Canvas/BattleRoot/WorldLayer",
      "components": [],
      "children": ["FarBackground", "MidBackground"]
    },
    {
      "path": "Canvas/BattleRoot/WorldLayer/FarBackground",
      "components": ["Sprite"],
      "resource": "Assets/World/MistBamboo/far/spriteFrame",
      "size": { "width": 750, "height": 1334 },
      "alpha": 255
    },
    {
      "path": "Canvas/BattleRoot/WorldLayer/MidBackground",
      "components": ["Sprite"],
      "resource": "Assets/World/MistBamboo/mid/spriteFrame",
      "size": { "width": 750, "height": 1334 },
      "alpha": 168,
      "parallax": "bounded-horizontal-drift"
    },
    {
      "path": "Canvas/BattleRoot/ActorLayer",
      "components": [],
      "children": ["Player", "EnemySpawner"]
    },
    {
      "path": "Canvas/BattleRoot/ActorLayer/Player",
      "components": ["Sprite", "AtlasAnimator", "PlayerController"],
      "bindings": {
        "animationManifest": "resources/Data/animation-atlas.json",
        "actorId": "qinglan-sword-cultivator"
      },
      "position": { "x": -210, "y": -80 },
      "scale": 0.8,
      "initialAction": "sword_ride"
    },
    {
      "path": "Canvas/BattleRoot/ActorLayer/EnemySpawner",
      "components": ["EnemySpawner"],
      "bindings": {
        "enemyPool": "Canvas/Pools/EnemyPool"
      },
      "purpose": "Task 5 runtime placeholder; Task 6 supplies the visual pool and template."
    },
    {
      "path": "Canvas/BattleRoot/EffectLayer",
      "components": [],
      "children": ["FlyingSwordSkill"]
    },
    {
      "path": "Canvas/BattleRoot/EffectLayer/FlyingSwordSkill",
      "components": ["FlyingSwordSkill"],
      "bindings": {
        "battleRuntime": "Canvas/BattleRoot/Runtime",
        "sword": "Canvas/BattleRoot/EffectLayer/FlyingSwordSkill/Sword"
      },
      "children": ["Sword"]
    },
    {
      "path": "Canvas/BattleRoot/EffectLayer/FlyingSwordSkill/Sword",
      "components": ["Sprite"],
      "resource": "Assets/Skills/FlyingSword/sword_projectile/spriteFrame"
    },
    {
      "path": "Canvas/BattleRoot/DropLayer",
      "components": [],
      "purpose": "Reserved for Task 6 drops."
    },
    {
      "path": "Canvas/BattleRoot/InputLayer",
      "components": ["UITransform", "BattleInputController"],
      "bindings": {
        "player": "Canvas/BattleRoot/ActorLayer/Player",
        "inputArea": "Canvas/BattleRoot/InputLayer"
      },
      "size": { "width": 750, "height": 1120 }
    },
    {
      "path": "Canvas/BattleRoot/HudLayer",
      "components": ["BattleHudController"],
      "children": ["TopHud", "BossHud", "BottomNavigation", "StageClearPanel", "StatusLabel"]
    },
    {
      "path": "Canvas/BattleRoot/HudLayer/TopHud",
      "components": ["Label", "ProgressBar"],
      "children": ["RealmLabel", "StageLabel", "HealthBar", "ManaBar", "SoulBar"]
    },
    {
      "path": "Canvas/BattleRoot/HudLayer/BossHud",
      "components": ["Label", "ProgressBar"],
      "active": false
    },
    {
      "path": "Canvas/BattleRoot/HudLayer/BottomNavigation",
      "components": ["Label"],
      "height": 104,
      "labels": ["战斗", "副本", "抽卡", "装备", "背包", "法宝"]
    },
    {
      "path": "Canvas/BattleRoot/HudLayer/StageClearPanel",
      "components": ["StageClearPanelController"],
      "active": false
    },
    {
      "path": "Canvas/BattleRoot/HudLayer/StatusLabel",
      "components": ["Label"],
      "active": false,
      "purpose": "Legacy runtime binding retained for Task 6 migration; no old information panel is rendered."
    },
    {
      "path": "Canvas/BattleRoot/Runtime",
      "components": ["BattleRuntimeController"],
      "bindings": {
        "designData": "resources/Data/cultivation-design.json",
        "statusLabel": "Canvas/BattleRoot/HudLayer/StatusLabel",
        "stageClearPanel": "Canvas/BattleRoot/HudLayer/StageClearPanel",
        "enemySpawner": "Canvas/BattleRoot/ActorLayer/EnemySpawner",
        "soulOrbPool": "Canvas/Pools/SoulOrbPool",
        "damageNumberPool": "Canvas/Pools/DamageNumberPool",
        "bossSkillEffectPool": "Canvas/Pools/BossSkillEffectPool"
      }
    },
    {
      "path": "Canvas/Pools",
      "components": [],
      "active": false,
      "children": ["SoulOrbPool", "DamageNumberPool", "BossSkillEffectPool", "EnemyPool"],
      "purpose": "Task 6 pool assembly contract."
    },
    {
      "path": "Canvas/Pools/SoulOrbPool",
      "components": ["NodePoolController"]
    },
    {
      "path": "Canvas/Pools/DamageNumberPool",
      "components": ["NodePoolController"]
    },
    {
      "path": "Canvas/Pools/BossSkillEffectPool",
      "components": ["NodePoolController"]
    },
    {
      "path": "Canvas/Pools/EnemyPool",
      "components": ["NodePoolController"]
    }
  ],
  "prefabs": [
    {
      "path": "prefabs/SoulOrb.prefab",
      "components": ["PoolableActor", "SoulOrbController"]
    },
    {
      "path": "prefabs/DamageNumber.prefab",
      "components": ["PoolableActor", "DamageNumberController", "Label"]
    },
    {
      "path": "prefabs/BossSkillEffect.prefab",
      "components": ["PoolableActor"]
    },
    {
      "path": "prefabs/Enemy.prefab",
      "components": ["PoolableActor", "EnemyController", "EnemyVisualController", "AtlasAnimator"]
    }
  ]
}
